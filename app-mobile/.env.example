# Supabase — values Supabase project ke Settings > API se.
# NOTE: yahan PUBLISHABLE (public) key hi. Secret key kabhi app mein nahi.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Free OCR (photo se text) — https://ocr.space/ocrapi (free key). Khali chhodo toh test key use hogi.
EXPO_PUBLIC_OCR_API_KEY=

# Web (landing) URL.
# Do kaam isse hote hain: checkout in-app browser mein isi se khulta hai, aur
# phone ka SMS OTP isi host ki /api/phone/* routes se jaata hai.
EXPO_PUBLIC_WEB_URL=https://apkasaathi.com
