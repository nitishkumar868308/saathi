# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Next.js ka build output — is folder me app ka apna koi code nahi hai.
# (Asli Next app `web/` me hai; ye yahan galti se ban gaya tha aur commit bhi
# ho gaya tha. eslint.config.js me bhi isi wajah se `.next/*` ignore hai.)
.next/
