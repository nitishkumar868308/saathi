{
  "name": "@reel/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript core \u2014 schema, timeline ops, keyframes, validation. Isme React ya DOM ka koi import nahi aata (studio aur worker dono ise chalate hain).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "immer": "^10.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2"
  }
}
