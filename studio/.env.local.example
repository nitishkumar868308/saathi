# AI Reel Studio (editor) ka env. Isko `studio/.env.local` me copy karo aur
# asli values bharo — .env.local gitignored hai, asli keys kabhi commit nahi hoti.

# --- Studio ka password gate ---
# Studio localhost par chalta hai, par gate phir bhi zaroori hai — ek din ye
# machine kisi network par hogi aur tab yaad nahi aayega ki gate tha hi nahi.
# Ye set nahi hai to studio khulta hi nahi (khaali password se sabko andar aane
# dena sabse buri default hai). Badalne par purane saare session apne aap mar
# jaate hain, kyunki cookie ka signing secret isi par tika hai.
STUDIO_PASSWORD=

# --- Supabase ---
# projects / project_versions / assets / render_jobs isi project me rehte hain.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key. Ye SIRF server-side route handlers me use hoti hai —
# kabhi NEXT_PUBLIC_ prefix mat lagana, warna browser me chali jaayegi.
SUPABASE_SERVICE_ROLE_KEY=

# Anon (public) key — worker ke asli kaam ke liye zaroori NAHI hai.
# Ye sirf `npm run db-verify` ke RLS check ke liye chahiye: wo anon key se
# reel_projects padhne ki koshish karta hai aur confirm karta hai ki 0 rows aayein.
# Iske bina wo check chupchaap skip ho jaata tha — jo "pass" jaisa dikhta hai
# par sach me koi jaanch hoti hi nahi.
# Ye key public hai (browser me bhi jaati hai), isliye ise rakhna surakshit hai.
SUPABASE_ANON_KEY=

# --- Cloudflare R2 (media + rendered MP4) ---
# Yehi 4 keys web/lib/r2.ts bhi padhta hai, naam jaan-boojhkar same rakhe hain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apkasaathi-storage

# --- Storage driver ---
# local = files disk pe (bina internet ke bhi kaam karta hai, dev ke liye)
# r2    = upload R2 pe
REEL_STORAGE_DRIVER=local

# local driver ke liye output/cache folder. Repo root se relative ya absolute.
REEL_OUTPUT_DIR=./render-out
# ⚠️ REEL_OUTPUT_DIR relative ho to wo **repo root** se resolve hota hai, us
# process ke cwd se nahi. Warna worker (repo root se chalta hai) aur studio
# (studio/ se chalta hai) do alag folder dekhte aur file "kho jaati".

# Local driver ka "signed URL" studio ke route se banta hai — studio kis URL par
# chal raha hai. Port badla ho to yahan bhi badlo.
REEL_LOCAL_MEDIA_BASE_URL=http://localhost:3000

# --- FFmpeg (sirf LOCAL ke liye) ---
# ⚠️ Ye Vercel par set karne ki cheez NAHI hai. Serverless me binary install hoti
# hi nahi, aur koi env var ffmpeg ko wahan la nahi sakta. Isiliye tasveer ka fit
# browser me canvas par hota hai (studio kahin bhi chale, wo chalta hai) — ffmpeg
# sirf VIDEO ke fit ke liye chahiye, aur wo tabhi hota hai jab studio tumhare PC
# par chal raha ho.
#
# Windows par sabse aam dikkat: ffmpeg install to hai par dev server PURANE
# terminal se chal raha hai, jisme naya PATH ghusa hi nahi. Us halat me sabse
# aasan ilaaj yahi hai — dev server band karo aur NAYE terminal se chalao.
# Wo na chale to yahan poora path likh do:
# REEL_FFMPEG_PATH=C:\path	ofmpeg.exe
# REEL_FFPROBE_PATH=C:\path	ofprobe.exe

# --- TTS: text se awaaz (Phase 22) ---
# Gemini se awaaz banane ke liye. Ye key `web/.env.local` me pehle se ho sakti
# hai (marketing site usi se anuvaad karti hai) — wahan se copy kar lo.
#
# ⚠️ Ye set nahi hai to Gemini wala option UI me "setup chahiye" dikhata hai
# aur generate ka button dabta hi nahi — chup-chaap fail hone se behtar hai.
# Baaki poora editor iske bina waise ka waisa chalta hai.
GEMINI_API_KEY=
#
# Model badalna ho to (default: gemini-2.5-flash-preview-tts)
#
# ⚠️ **Model badalne se pehle uska per-call kharcha dekh lo.** 24 Aug 2026 ko
# default kuch der ke liye `gemini-3.1-flash-tts-preview` tha, aur us ek din ka
# bill aisa tha:
#     Gemini 3.1 Flash TTS —  9 call → ₹393.81  (~₹44 per call)
#     Gemini 2.5 Flash TTS — 97 call → ₹ 16.95  (~₹0.17 per call)
# Ek hi kaam, ~260 guna keemat — aur uska koi nishaan UI me nahi tha: awaaz
# banti thi, achhi banti thi, koi error nahi aata tha. Farak sirf bill me tha.
# GEMINI_TTS_MODEL=

# --- Roz ki hadd (26.27) ---
# Ek din me kitni ASLI call jaane di jaayein. Cache se aayi awaaz ginti me nahi
# aati (wo Google tak jaati hi nahi); fail hui call aati hai (wo ja chuki hoti
# hai aur paisa laga chuki hoti hai).
#
# ⚠️ Ye hadd feature nahi, brake hai. Iske bina kharche par koi upar wali rok
# nahi hoti — sirf provider ki apni limit hoti hai, jo paise se nahi, calls ki
# ginti se lagti hai. Set na karo to defaults chalte hain: TTS 60, AI 30.
# REEL_TTS_DAILY_LIMIT=60
# REEL_AI_DAILY_LIMIT=30

# --- Cloud render worker (Phase 25) ---
# Reel Vercel par nahi ban sakti (Chrome Headless ~150MB + ffmpeg + minute bhar
# ka kaam). Isliye render GitHub Actions ke runner par hota hai, aur studio sirf
# use jagati hai — Export dabate hi.
#
# ⚠️ Ye dono set nahi honge to studio "local mode" me chalegi: job queue me
# jaayegi aur `npm run dev:worker` ka intezaar karegi. Ye jhooth nahi bolti —
# Renders panel me saaf "Worker offline" likha aata hai.
#
# ⚠️ Cloud worker chalu karne se pehle STORAGE dekh lo. Upar wala
# REEL_STORAGE_DRIVER `r2` hona chahiye (R2 ki chaaron keys ke saath), warna
# runner tumhare disk ki assets nahi dhoondh paayega aur har render fail hoga.
# Purani local media chadhane ke liye:
#   npm run migrate:r2 --workspace @reel/worker -- --dry-run
#   npm run migrate:r2 --workspace @reel/worker
#
# owner/repo — jahan .github/workflows/reel-render.yml pada hai.
REEL_DISPATCH_REPO=nitishkumar868308/saathi
#
# GitHub PAT (fine-grained). Sirf is repo par, sirf itni permission:
#   Contents: Read and write     ← repository_dispatch isi ke neeche aata hai
# ⚠️ Access na hone par GitHub 404 deta hai, "403" nahi — private repo ka wajood
# wo jaan-boojhkar nahi batata. Isliye 404 aaye to pehle token dekho, repo ka
# naam baad me.
REEL_DISPATCH_TOKEN=

# Safety net cron ka secret (supabase/cron-reel-dispatch.sql).
# ⚠️ Ye zaroori nahi hai — iske bina bhi export turant dispatch hota hai. Ye sirf
# us job ke liye hai jo dispatch fail hone ki wajah se queue me atak gayi ho.
# web wale project me jo CRON_SECRET hai, wahi yahan bhi rakh sakte ho.
CRON_SECRET=
