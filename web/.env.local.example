# Supabase (asli DB) — waitlist + contact_messages tables ke liye.
# Tables banane ke liye: supabase/landing.sql ko SQL Editor mein Run karo.
# SERVICE ROLE key: Dashboard > Project Settings > API > service_role secret.
# IMPORTANT: service_role key sirf server pe (kabhi frontend/app mein nahi).
# Khaali chhodo toh data local data/*.json file mein save hota hai (dev fallback).
SUPABASE_URL=https://oqzirntinuwqtxfiyikb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin) login password
ADMIN_PASSWORD=

# Gmail SMTP (email bhejne ke liye) — 2-step + App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=

# Razorpay payment gateway — Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Site URL — SEO (canonical, sitemap, robots, OG) ke liye. Prod domain daalo.
NEXT_PUBLIC_SITE_URL=https://saathi.app

# Waitlist social-proof count ka base number ("500+ log jud chuke hain").
# DB judne tak yahi dikhega. Optional — default 500.
WAITLIST_BASE_COUNT=500

# Analytics (optional) — GA4 measurement ID. Khali chhodo toh analytics off.
NEXT_PUBLIC_GA_ID=

# Email (Gmail SMTP) — waitlist welcome + contact emails ke liye.
# 2-step verification ON karo, phir Google Account > Security > App passwords
# se 16-char app password banao (normal Gmail password nahi chalega).
GMAIL_USER=tumhara@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Contact form messages kahan aayein (optional, default GMAIL_USER):
CONTACT_TO=

# Is file ko copy karke ".env.local" banao aur values bharo.
# Vercel pe deploy karte waqt ye same vars Project Settings > Environment Variables mein add karna.
