# ---------------------------------------------------------------------------
# Apka Saathi — web env
#
# Is file ko copy karke `.env.local` banao aur values bharo.
# Deploy pe yahi vars Vercel > Project Settings > Environment Variables me daalo.
#
# ⚠️ Env sirf server START pe padha jaata hai — badalne ke baad `npm run dev`
#    band karke dobara chalao, warna purani values hi chalti rahengi.
# ---------------------------------------------------------------------------

# --- Supabase: SERVER side (kabhi browser me nahi) -------------------------
# Dashboard > Project Settings > API > Project API keys > service_role (Reveal)
# service_role RLS bypass karti hai — poore DB ka master key. Kabhi bhi
# NEXT_PUBLIC_ prefix ke saath ya app ki .env me mat daalna.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: BROWSER side (/referral page ke login ke liye) --------------
# Wahi URL jo upar hai. Key = `anon` / `public` (service_role NAHI).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site --------------------------------------------------------------------
# SEO (canonical, sitemap, robots, OG), email ke logo/link, aur Google OAuth
# redirect isi se bante hain. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://apkasaathi.com

# Play Store link (optional — default code me hai)
NEXT_PUBLIC_PLAY_STORE_URL=

# --- Admin dashboard (/admin) ------------------------------------------------
ADMIN_PASSWORD=

# --- Email (Gmail SMTP) ------------------------------------------------------
# 2-step verification ON karo, phir Google Account > Security > App passwords
# se 16-char app password banao (normal Gmail password nahi chalega).
GMAIL_USER=tumhara@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Contact form messages kahan aayein (optional, default GMAIL_USER)
CONTACT_TO=

# --- Twilio (WhatsApp reminders + phone ka SMS OTP) --------------------------
# Console > Account > API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Live WhatsApp sender (Messaging > Senders > WhatsApp senders).
# Testing ke liye sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+919625942175

# Meta-approved template SIDs — HAR BHASHA KA APNA.
#
# WhatsApp par business apni marzi ka text bhej hi nahi sakta (24h window ke
# bahar): sirf approved template jaata hai, aur uska poora text Twilio console
# me pada hota hai. Isliye bhasha badalna = alag template. Bina suffix wala
# Hinglish hai (app ka default). Kisi bhasha ka SID na ho to code Hinglish par
# gir jaata hai.
#
# Content Template Builder me banao (sab Utility category):
#   saathi_reminder_hinglish / _hi / _en
#   saathi_document_hinglish / _hi / _en
TWILIO_TEMPLATE_REMINDER_SID=
TWILIO_TEMPLATE_REMINDER_SID_HI=
TWILIO_TEMPLATE_REMINDER_SID_EN=
TWILIO_TEMPLATE_DOCUMENT_SID=
TWILIO_TEMPLATE_DOCUMENT_SID_HI=
TWILIO_TEMPLATE_DOCUMENT_SID_EN=

# --- Phone verification (Twilio Verify) --------------------------------------
# Console > Verify > Services > tumhari service ka SID (VA...).
# Verify khud OTP banata, bhejta aur check karta hai — koi alag SMS number ya
# template nahi chahiye.
TWILIO_VERIFY_SERVICE_SID=

# Reminder cron ko protect karne ke liye koi lamba random string.
# Yahi value supabase/cron-reminders.sql me bhi daalni hai.
CRON_SECRET=

# --- Admin ke message ka anuvaad (Gemini) ------------------------------------
# Admin ek hi bhasha me likhta hai; bhejte waqt har user ki apni bhasha me badal
# jaata hai (Hinglish / Hindi / English) — email aur phone ki notification, dono.
#
# Yahi key hai jo Supabase → Edge Functions → Secrets me GEMINI_API_KEY ke naam
# se padi hai (aistudio.google.com/apikey se banti hai). Wahan se copy kar lo.
#
# Khaali chhodo to /admin ka anuvaad wala toggle band dikhega aur message bilkul
# waisa hi jaayega jaisa likha hai — kuch tootega nahi.
GEMINI_API_KEY=

# --- Analytics (optional) ----------------------------------------------------
# GA4 measurement ID. Khaali chhodo to analytics off.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Google Play Billing (abhi BAND hai)
# ---------------------------------------------------------------------------
# Saathi Plus ek digital subscription hai — Play Store ki policy me uske liye
# Google ke apne billing ke alawa kuch nahi chal sakta. Razorpay wala website
# checkout isliye poori tarah hata diya gaya hai.
#
# Dono set hone par hi /api/play/webhook kaam karta hai. Ek bhi na ho to wo 503
# lautata hai (200 nahi) — taaki RevenueCat event dobara bhejta rahe aur chalu
# karne se pehle wali kharidariyan gum na ho jayein.
PLAY_BILLING_ENABLED=
REVENUECAT_WEBHOOK_SECRET=

# Admin ke bheje message ka open/click track karne ke liye HMAC secret.
# Na ho to service-role key se kaam chal jaata hai (wo bhi sirf server par hai).
MESSAGE_TRACK_SECRET=
