# ---------------------------------------------------------------------------
# Apka Saathi — web env
#
# Is file ko copy karke `.env.local` banao aur values bharo.
# Deploy pe yahi vars Vercel > Project Settings > Environment Variables me daalo.
#
# ⚠️ Env sirf server START pe padha jaata hai — badalne ke baad `npm run dev`
#    band karke dobara chalao, warna purani values hi chalti rahengi.
# ---------------------------------------------------------------------------

# --- Supabase: SERVER side (kabhi browser me nahi) -------------------------
# Dashboard > Project Settings > API > Project API keys > service_role (Reveal)
# service_role RLS bypass karti hai — poore DB ka master key. Kabhi bhi
# NEXT_PUBLIC_ prefix ke saath ya app ki .env me mat daalna.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: BROWSER side (/referral page ke login ke liye) --------------
# Wahi URL jo upar hai. Key = `anon` / `public` (service_role NAHI).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site --------------------------------------------------------------------
# SEO (canonical, sitemap, robots, OG), email ke logo/link, aur Google OAuth
# redirect isi se bante hain. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://apkasaathi.com

# Play Store link (optional — default code me hai)
NEXT_PUBLIC_PLAY_STORE_URL=

# --- Cloudflare R2 (saari file storage) --------------------------------------
# Documents (passport/insurance/PDF) aur profile photo — sab yahan. Supabase
# Storage ab bilkul use nahi hota.
#
# Kahan se milta hai:
#   R2_ACCOUNT_ID        Cloudflare dashboard > R2 > (dayein taraf) Account ID
#   R2_ACCESS_KEY_ID     R2 > Manage R2 API Tokens > Create API Token
#   R2_SECRET_ACCESS_KEY  ⤷ wahi se, sirf EK BAAR dikhti hai — turant copy karo
#   R2_BUCKET            bucket ka naam (apkasaathi-storage)
#
# Token banate waqt permission "Object Read & Write" chuno, aur ho sake to use
# sirf isi bucket tak seemit rakho.
#
# ⚠️ Bucket ko PUBLIC mat karna. Usme logon ke passport aur insurance padte
#    hain. Profile photo isi wajah se `/api/avatar/<uid>` se hokar jaati hai —
#    bucket band rehta hai, photo phir bhi khulti hai.
#
# ⚠️ Ye chaaron SIRF yahan (web ke env) me jaate hain. App ki .env me kabhi
#    nahi — R2 ki key ke aage RLS jaisi koi doosri deewar nahi hoti, ek APK
#    khol kar koi bhi sabki files padh lega. App apna Supabase token le kar
#    /api/storage/* pe aati hai aur server uske apne folder ka chhoti umar wala
#    URL banata hai.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apkasaathi-storage

# --- Admin dashboard (/admin) ------------------------------------------------
ADMIN_PASSWORD=

# --- Email (Gmail SMTP) ------------------------------------------------------
# 2-step verification ON karo, phir Google Account > Security > App passwords
# se 16-char app password banao (normal Gmail password nahi chalega).
GMAIL_USER=tumhara@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Contact form messages kahan aayein (optional, default GMAIL_USER)
CONTACT_TO=

# --- Twilio (WhatsApp reminders + phone ka SMS OTP) --------------------------
# Console > Account > API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Live WhatsApp sender (Messaging > Senders > WhatsApp senders).
# Testing ke liye sandbox: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+919625942175

# Meta-approved template SIDs — HAR BHASHA KA APNA.
#
# WhatsApp par business apni marzi ka text bhej hi nahi sakta (24h window ke
# bahar): sirf approved template jaata hai, aur uska poora text Twilio console
# me pada hota hai. Isliye bhasha badalna = alag template. Bina suffix wala
# Hinglish hai (app ka default). Kisi bhasha ka SID na ho to code Hinglish par
# gir jaata hai.
#
# Content Template Builder me banao (sab Utility category):
#   saathi_reminder_hinglish / _hi / _en
#   saathi_document_hinglish / _hi / _en
TWILIO_TEMPLATE_REMINDER_SID=
TWILIO_TEMPLATE_REMINDER_SID_HI=
TWILIO_TEMPLATE_REMINDER_SID_EN=
TWILIO_TEMPLATE_DOCUMENT_SID=
TWILIO_TEMPLATE_DOCUMENT_SID_HI=
TWILIO_TEMPLATE_DOCUMENT_SID_EN=

# --- Phone verification (Twilio Verify) --------------------------------------
# Console > Verify > Services > tumhari service ka SID (VA...).
# Verify khud OTP banata, bhejta aur check karta hai — koi alag SMS number ya
# template nahi chahiye.
TWILIO_VERIFY_SERVICE_SID=

# Reminder cron ko protect karne ke liye koi lamba random string.
# Yahi value supabase/cron-reminders.sql me bhi daalni hai.
CRON_SECRET=

# --- Admin ke message ka anuvaad (Gemini) ------------------------------------
# Admin ek hi bhasha me likhta hai; bhejte waqt har user ki apni bhasha me badal
# jaata hai (Hinglish / Hindi / English) — email aur phone ki notification, dono.
#
# Yahi key hai jo Supabase → Edge Functions → Secrets me GEMINI_API_KEY ke naam
# se padi hai (aistudio.google.com/apikey se banti hai). Wahan se copy kar lo.
#
# Khaali chhodo to /admin ka anuvaad wala toggle band dikhega aur message bilkul
# waisa hi jaayega jaisa likha hai — kuch tootega nahi.
GEMINI_API_KEY=

# --- Analytics (optional) ----------------------------------------------------
# GA4 measurement ID. Khaali chhodo to analytics off.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Google Play Billing (abhi BAND hai)
# ---------------------------------------------------------------------------
# Saathi Plus ek digital subscription hai — Play Store ki policy me uske liye
# Google ke apne billing ke alawa kuch nahi chal sakta. Razorpay wala website
# checkout isliye poori tarah hata diya gaya hai.
#
# Dono set hone par hi /api/play/webhook kaam karta hai. Ek bhi na ho to wo 503
# lautata hai (200 nahi) — taaki RevenueCat event dobara bhejta rahe aur chalu
# karne se pehle wali kharidariyan gum na ho jayein.
PLAY_BILLING_ENABLED=
REVENUECAT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Play Console ka price website/admin par dikhane ke liye
# ---------------------------------------------------------------------------
# Price sirf Play Console me set hota hai — wahi ek sach hai. App wahi daam
# seedha Play se padh leti hai. Website aur admin par Play Billing hota hi
# nahi, isliye server roz ek baar Play Developer API se har desh ka daam laata
# hai aur `play_prices` table me rakh deta hai.
#
# Ye teeno na hon to kuch tootta nahi — website purane manual hisaab
# (Admin > Pricing wali table) par chalti rehti hai.
#
# Poora setup step-by-step: docs/play-prices.md
#
#   1. Google Cloud Console me "Google Play Android Developer API" enable karo.
#   2. Ek service account banao > Keys > Add key > JSON. Wo poori JSON yahan.
#      Vercel me base64 karke daalna behtar hai (JSON ke andar newline hote
#      hain aur wo dashboard me aksar toot jaate hain) — code dono padh leta hai:
#         base64 -w0 sa.json
#   3. Play Console > Users and permissions > us service account ko invite karo
#      aur is app ka access do. Ye step bhoolne par Google 403 deta hai, chahe
#      key bilkul sahi ho.
GOOGLE_PLAY_SA_JSON=

# App ka applicationId — wahi jo Play Console me hai (com.apkasaathi.app jaisa).
GOOGLE_PLAY_PACKAGE_NAME=

# Play Console ke subscription id. Khaali chhodo to plus_monthly / plus_yearly
# maan liye jaate hain — app ka code bhi yahi dhoondhta hai
# (app-mobile/src/app/upgrade.tsx), isliye badalna ho to DONO jagah dekhna.
PLAY_PRODUCT_MONTHLY=
PLAY_PRODUCT_YEARLY=

# Admin ke bheje message ka open/click track karne ke liye HMAC secret.
# Na ho to service-role key se kaam chal jaata hai (wo bhi sirf server par hai).
MESSAGE_TRACK_SECRET=

# ─────────────────────────── OTP ke pepper ───────────────────────────
#
# Teen jagah 6 ank ka code bhejte hain, aur teenon me code ka sirf HASH DB me
# jaata hai. Pepper wo secret hai jo hash me milaya jaata hai aur DB ke BAHAR
# rehta hai.
#
# ⚠️ Ye set karna ZAROORI hai. Set na ho to code ek tay string par gir jaata hai
# jo is repo me likhi hui hai (lib/otp.ts, lib/app-lock.ts, lib/device-approval.ts).
# Us soorat me 6 ank ke poore 10 lakh hash pehle se banaye ja sakte hain — yaani
# DB ka ek backup ya ek galat SELECT leak ho jaye to har zinda code padha ja
# sakta hai. Pepper ke saath ye namumkin hai.
#
# Value: koi bhi lamba random secret. Banane ka tareeka —
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   (ya)  openssl rand -hex 32
#
# ⚠️ Badalne par us waqt ke saare zinda code turant bekaar ho jaate hain (user ko
# naya mangwana padega). Isliye ek baar set karo aur chhedo mat.
#
# Teen alag isliye hain ki ek badalna/leak hona baaki do ko na le doobe. Neeche
# wale do na ho to upar wale par gir jaate hain — par production me teenon alag
# rakhna hi sahi hai.
OTP_PEPPER=
APP_LOCK_PEPPER=
DEVICE_APPROVAL_PEPPER=
