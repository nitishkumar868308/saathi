# Supabase (jab waitlist ko DB se jodna ho) — values Supabase project ke Settings > API se
# IMPORTANT: SERVICE ROLE key sirf server pe (API route mein). App mein kabhi nahi.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Is file ko copy karke ".env.local" banao aur values bharo.
# Vercel pe deploy karte waqt ye same vars Project Settings > Environment Variables mein add karna.
