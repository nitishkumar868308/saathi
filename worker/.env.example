# Render worker ka env. Isko `worker/.env` me copy karo aur asli values bharo.
# Worker tumhare PC pe chalta hai — ye keys kabhi Vercel pe nahi jaati.

# --- Supabase ---
# Worker render_jobs ko claim karta hai (FOR UPDATE SKIP LOCKED), isliye ise
# service role chahiye — anon key se ye update nahi kar payega.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anon (public) key — worker ke asli kaam ke liye zaroori NAHI hai.
# Ye sirf `npm run db-verify` ke RLS check ke liye chahiye: wo anon key se
# reel_projects padhne ki koshish karta hai aur confirm karta hai ki 0 rows aayein.
# Iske bina wo check chupchaap skip ho jaata tha — jo "pass" jaisa dikhta hai
# par sach me koi jaanch hoti hi nahi.
# Ye key public hai (browser me bhi jaati hai), isliye ise rakhna surakshit hai.
SUPABASE_ANON_KEY=

# --- Cloudflare R2 (assets download + final MP4 upload) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apkasaathi-storage

# --- Storage driver ---
# local = MP4 disk pe hi rahega, r2 = upload ho jaayega.
REEL_STORAGE_DRIVER=local

# Render output + asset cache yahan banta hai. Ye folder gitignored hai.
REEL_OUTPUT_DIR=./render-out
# ⚠️ REEL_OUTPUT_DIR relative ho to wo **repo root** se resolve hota hai, us
# process ke cwd se nahi. Warna worker (repo root se chalta hai) aur studio
# (studio/ se chalta hai) do alag folder dekhte aur file "kho jaati".

# Local driver ka "signed URL" studio ke route se banta hai — studio kis URL par
# chal raha hai. Port badla ho to yahan bhi badlo.
REEL_LOCAL_MEDIA_BASE_URL=http://localhost:3000

# --- Drain mode (GitHub Actions ke runner ke liye) ---
# Ye teeno tumhare PC par set NAHI karne hain. Yahan sirf isliye likhe hain ki
# `.github/workflows/reel-render.yml` inhi ko bhejta hai, aur env ka ek hi
# reference hona chahiye.
#
# REEL_WORKER_ONCE=1
#   Queue khaali hote hi worker khud band ho jaata hai (`npm run start:once`
#   isi ka shortcut hai). Runner par hamesha chalte rehna do tarah se galat hai:
#   ya 6 ghante ka timeout aata hai, ya minute khaali baithe kat'te rehte hain.
#   ⚠️ Is mode me REEL_STORAGE_DRIVER=r2 zaroori hai — runner ki disk run ke
#   saath mit jaati hai. Worker shuru me hi ye jaanch karta hai.
#
# REEL_WORKER_KINDS=render
#   Runner sirf render uthata hai. Transcribe ko faster-whisper chahiye jo wahan
#   pehle se nahi hota — bina is filter ke wo job runner par jaakar fail hoti,
#   jabki tumhare PC par bilkul chal jaati. Khaali chhodo = dono (default).
#
# REEL_WORKER_IDLE_EXIT_MS=20000  — itni der queue khaali rahi to nikal jao.
# REEL_WORKER_MAX_RUN_MS=4800000  — kul 80 minute; uske baad nayi job nahi uthti.
# REEL_WORKER_VERSION=cloud       — heartbeat me nishaan, taaki studio me pata chale.
