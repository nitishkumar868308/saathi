# Render worker ka env. Isko `worker/.env` me copy karo aur asli values bharo.
# Worker tumhare PC pe chalta hai — ye keys kabhi Vercel pe nahi jaati.

# --- Supabase ---
# Worker render_jobs ko claim karta hai (FOR UPDATE SKIP LOCKED), isliye ise
# service role chahiye — anon key se ye update nahi kar payega.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (assets download + final MP4 upload) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apkasaathi-storage

# --- Storage driver ---
# local = MP4 disk pe hi rahega, r2 = upload ho jaayega.
REEL_STORAGE_DRIVER=local

# Render output + asset cache yahan banta hai. Ye folder gitignored hai.
REEL_OUTPUT_DIR=./render-out
# ⚠️ REEL_OUTPUT_DIR relative ho to wo **repo root** se resolve hota hai, us
# process ke cwd se nahi. Warna worker (repo root se chalta hai) aur studio
# (studio/ se chalta hai) do alag folder dekhte aur file "kho jaati".

# Local driver ka "signed URL" studio ke route se banta hai — studio kis URL par
# chal raha hai. Port badla ho to yahan bhi badlo.
REEL_LOCAL_MEDIA_BASE_URL=http://localhost:3000
