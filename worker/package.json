{
  "name": "@reel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Render worker \u2014 tumhare PC pe chalta hai. render_jobs table poll karta hai, Remotion se render karta hai, R2 pe upload karta hai. Vercel pe kabhi nahi jaata.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storage-smoke": "tsx scripts/storage-smoke.ts",
    "db-verify": "tsx scripts/db-verify.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "render:template": "tsx scripts/render-template.ts",
    "render:mockup": "tsx scripts/render-mockup.ts",
    "render:captions": "tsx scripts/render-captions.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "validate:demo": "tsx scripts/validate-demo.ts",
    "tts:smoke": "tsx scripts/tts-smoke.ts",
    "transcribe:smoke": "tsx scripts/transcribe-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@reel/core": "*",
    "@reel/media": "*",
    "@reel/storage": "*",
    "@remotion/bundler": "4.0.513",
    "@remotion/renderer": "4.0.513"
  }
}
